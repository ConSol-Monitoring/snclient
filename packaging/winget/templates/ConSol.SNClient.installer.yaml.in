    UpgradeCode: '{F4BF03F6-D3DA-44FF-A444-9B64119DA0CE}'
    InstallerType: wix
  InstallationMetadata:
    DefaultInstallLocation: '%ProgramFiles(x86)%\snclient'
    Files:
    - RelativeFilePath: snclient.exe
      FileType: launch
      InvocationParameter: --version
- Architecture: arm64
  InstallerUrl: https://github.com/ConSol-Monitoring/snclient/releases/download/v__TAG_VERSION__/snclient-__TAG_VERSION__-windows-aarch64.msi
  InstallerSha256: __SHA256_ARM64__
