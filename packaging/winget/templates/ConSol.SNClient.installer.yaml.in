  InstallerSha256: __SHA256_X64__
  ProductCode: '__PRODUCT_CODE_X64__'
  AppsAndFeaturesEntries:
  - DisplayName: SNClient
    Publisher: ConSol Consulting and Solutions Software GmbH
    ProductCode: '__PRODUCT_CODE_X64__'
    UpgradeCode: '{F4BF03F6-D3DA-44FF-A444-9B64119DA0CE}'
    InstallerType: wix
  InstallationMetadata:
    DefaultInstallLocation: '%ProgramFiles%\snclient'
    Files:
    - RelativeFilePath: snclient.exe
      FileType: launch
      InvocationParameter: --version
- Architecture: x86
